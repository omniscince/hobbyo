@startuml context
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam dpi 160
skinparam ArrowColor #444444
skinparam nodesep 18
skinparam ranksep 230
skinparam rectangle {
  BackgroundColor #E1F5EE
  BorderColor #0F6E56
  FontColor #04342C
  FontSize 15
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam node {
  BackgroundColor #F1EFE8
  BorderColor #5F5E5A
}
left to right direction

actor "Гость" as G
actor "Пользователь" as U
actor "Организация" as O
actor "Администратор" as A

rectangle "\n\n**Hobbyo**\n\nсистема подбора хобби\nи записи на пробные занятия\n\n\n" as S

node "Платёжная система\n(MBank, Элсом, O!Деньги)" as PAY
node "2ГИС API" as MAP
node "Google Calendar" as CAL
node "SMS-шлюз" as SMS
node "Почтовый сервер\n(SMTP)" as MAIL

G --> S : <b>Г1 запросы:</b>\nкаталог хобби (категория, поиск)\nбандлы\nданные регистрации: тип аккаунта,\nимя, телефон, email, пароль\nкод из SMS
G <-- S : <b>Г2 ответы:</b>\nхобби: название, категория, фото,\nцена пробного, число организаций\nбандлы: название, состав\nрезультат регистрации

U --> S : <b>П1 запросы:</b>\nответы анкеты: возраст, категории,\nбюджет, часы в неделю, формат, районы\nсвободные окна: день, время с/по\nвыбор бандла (1–3 хобби)\nпоиск слотов: хобби, 14 дней\nпоиск на карте: хобби, точка, радиус\nзапись: слот\nоплата записи\nотмена записи: номер записи\nоформление подписки Pro
U <-- S : <b>П2 ответы:</b>\nрекомендации: хобби, % совпадения\nподходящие слоты: организация,\nдата/время, цена, свободные места\nорганизации на карте: адрес\nзапись: номер, статус\nчек оплаты / статус возврата\nфайл .ics\nнапоминания за 24 ч и 2 ч (email)

O --> S : <b>О1 запросы:</b>\nпрофиль: название, категория, адрес,\nтелефон, Instagram, фото\nзанятие: хобби, возраст, длительность,\nцена, макс. участников, срок отмены\nслоты: дата, время, повтор, недели\nотмена слота\nоплата продвижения: занятие, 7/30 дней
O <-- S : <b>О2 ответы:</b>\nопубликованные слоты\nучастники слота: имя, телефон,\nстатус записи\nстатус продвижения

A --> S : <b>А1 запросы:</b>\nхобби и категории:\nсоздать / изменить / скрыть\nбандл: название, 3–10 хобби
A <-- S : <b>А2 ответы:</b>\nкаталог хобби\nсписок бандлов

S --> PAY : <b>Р1:</b> платёж: номер записи /\nподписки / продвижения, сумма (KGS)\nвозврат: ID платежа, сумма
S <-- PAY : <b>Р2:</b> статус платежа\nи возврата: ID, успешно / отклонено

S --> MAP : <b>К1:</b> адрес организации\nкоординаты точки, радиус
S <-- MAP : <b>К2:</b> широта, долгота\nфрагмент карты

S --> CAL : <b>Кл1:</b> событие: занятие,\nдата/время, адрес
S <-- CAL : <b>Кл2:</b> ID события

S --> SMS : <b>С1:</b> телефон,\n6-значный код
S <-- SMS : <b>С2:</b> статус доставки

S --> MAIL : <b>E1:</b> email, тема, текст
S <-- MAIL : <b>E2:</b> статус отправки

@enduml
